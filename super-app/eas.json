{
  "cli": {
    "version": ">= 9.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "dev"
      }
    },
    "preview-dev-apk": {
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "dev"
      }
    },
    "preview-uat": {
      "distribution": "internal",
      "channel": "preview-uat",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "uat"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_ENV": "prod"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
