{
  "expo": {
    "name": "intrustDSS Super App",
    "slug": "intrustdss-super-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.intrustdss.superapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "vn.intrustdss.superapp",
      "permissions": [
        "CAMERA",
        "CAMERA_FLASH",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Super App intrustDSS cần quyền Camera để quét mã vạch thùng, container và ký số tài liệu."
        }
      ],
      "expo-asset",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "82663d3b-b30c-4994-b3d9-f12b32accee9"
      }
    }
  }
}
