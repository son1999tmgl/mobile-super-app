{
  "name": "intrustdss-super-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:dev": "node -e \"require('fs').writeFileSync('.env', 'APP_ENV=dev\\nEXPO_PUBLIC_APP_ENV=dev\\n')\" && expo start",
    "start:uat": "node -e \"require('fs').writeFileSync('.env', 'APP_ENV=uat\\nEXPO_PUBLIC_APP_ENV=uat\\n')\" && expo start",
    "start:prod": "node -e \"require('fs').writeFileSync('.env', 'APP_ENV=prod\\nEXPO_PUBLIC_APP_ENV=prod\\n')\" && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "update:dev": "eas update --branch development --message 'Dev OTA update'",
    "update:uat": "eas update --branch preview-uat --message 'UAT OTA update'",
    "update:prod": "eas update --branch production --message 'Production OTA update'"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@intrustdss/ebhxh": "file:../packages/intrustdss-ebhxh",
    "@intrustdss/econtract": "file:../packages/intrustdss-econtract",
    "@intrustdss/infarm": "file:../packages/intrustdss-infarm",
    "@intrustdss/intrace": "file:../packages/intrustdss-intrace",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "expo": "^52.0.0",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.18",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-updates": "~0.27.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
