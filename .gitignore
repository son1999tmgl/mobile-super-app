.env
.env.local
.env.*.local
*.pem
*.key
*.keystore
*.jks

# Build artifacts cục bộ
*.apk
*.aab
*.ipa
*.zip
*.tar.gz

# Hệ điều hành
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo

# EAS Update & EAS Build cache
.eas/
